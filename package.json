{
    "name": "label-studio",
    "version": "0.0.1-beta",
    "description": "Electron + TypeScript conversion of the Swift Label Studio launcher. Chromium/CEF runtime logic is replaced by Electron runtime checking.",
    "main": "dist/main/main.js",
    "scripts": {
        "build": "node scripts/build.js",
        "start": "node scripts/run-start.js",
        "dev": "npm run start",
        "typecheck": "node ./node_modules/typescript/lib/tsc.js -p tsconfig.json --noEmit",
        "build:windows-installer": "node scripts/build-windows-installer.js",
        "pack:mac": "npm run build && node scripts/run-electron-builder.js --mac dir --universal",
        "dist:mac": "npm run build && node scripts/run-electron-builder.js --mac dmg --universal",
        "pack:win": "node scripts/run-windows-package.js dir",
        "dist:win": "node scripts/run-windows-package.js nsis",
        "pack:linux": "npm run build && node scripts/run-electron-builder.js --linux dir",
        "dist:linux": "npm run build && node scripts/run-electron-builder.js --linux tar.gz",
        "pack:all": "npm run pack:mac && npm run pack:win && npm run pack:linux",
        "dist:all": "npm run dist:mac && npm run dist:win && npm run dist:linux",
        "clean": "rm -rf dist release .runtime Runtime runtime .runtime-cache cache node_modules package-lock.json"
    },
    "devDependencies": {
        "@types/node": "^22.13.14",
        "@types/tar-stream": "^3.1.4",
        "electron": "37.10.3",
        "electron-builder": "26.0.12",
        "typescript": "^5.8.3"
    },
    "build": {
        "appId": "io.codex.labelstudio",
        "productName": "Label Studio",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "!dist/scripts/**/*",
            "!dist/windows-installer/**/*",
            "icons/**/*",
            "package.json"
        ],
        "mac": {
            "icon": "icons/logo.icns",
            "target": [
                {
                    "target": "dir",
                    "arch": [
                        "universal"
                    ]
                },
                {
                    "target": "dmg",
                    "arch": [
                        "universal"
                    ]
                }
            ],
            "category": "public.app-category.developer-tools",
            "extraResources": [
                {
                    "from": "Assets",
                    "to": "Assets"
                },
                {
                    "from": "dist/scripts",
                    "to": "Scripts"
                }
            ]
        },
        "win": {
            "icon": "icons/logo.ico",
            "extraResources": [
                {
                    "from": "assets",
                    "to": "assets"
                },
                {
                    "from": "dist/scripts",
                    "to": "scripts"
                },
                {
                    "from": "dist/windows-installer/${arch}/Label Studio Installer.exe",
                    "to": "installer/Label Studio Installer.exe"
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "perMachine": true,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Label Studio"
        },
        "linux": {
            "icon": "icons/linux/logo.svg",
            "target": [
                {
                    "target": "dir"
                },
                {
                    "target": "tar.gz"
                }
            ],
            "extraResources": [
                {
                    "from": "assets",
                    "to": "assets"
                },
                {
                    "from": "dist/scripts",
                    "to": "scripts"
                }
            ]
        }
    },
    "dependencies": {
        "tar-stream": "^3.2.0",
        "unbzip2-stream": "^1.4.3"
    }
}
